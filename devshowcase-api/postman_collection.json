{
  "info": {
    "name": "DevShowcase API - Etapa 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "1. Criar Profile",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Maria Silva\",\n  \"email\": \"maria@email.com\",\n  \"bio\": \"Desenvolvedora backend apaixonada por Java\",\n  \"githubUrl\": \"https://github.com/mariasilva\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/profiles", "host": ["{{baseUrl}}"], "path": ["api", "profiles"] }
      }
    },
    {
      "name": "2. Buscar Profile por id",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/profiles/1", "host": ["{{baseUrl}}"], "path": ["api", "profiles", "1"] }
      }
    },
    {
      "name": "3. Criar Technology",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Spring Boot\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/technologies", "host": ["{{baseUrl}}"], "path": ["api", "technologies"] }
      }
    },
    {
      "name": "4. Listar Technologies",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/technologies", "host": ["{{baseUrl}}"], "path": ["api", "technologies"] }
      }
    },
    {
      "name": "5. Criar Project",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"DevShowcase API\",\n  \"description\": \"API para exibir portfolio de projetos\",\n  \"repositoryUrl\": \"https://github.com/mariasilva/devshowcase-api\",\n  \"profileId\": 1,\n  \"technologyIds\": [1]\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
      }
    },
    {
      "name": "6. Listar Projects",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
      }
    },
    {
      "name": "7. Erro de validacao (Profile sem email)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"\",\n  \"email\": \"\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/profiles", "host": ["{{baseUrl}}"], "path": ["api", "profiles"] }
      }
    }
  ]
}

